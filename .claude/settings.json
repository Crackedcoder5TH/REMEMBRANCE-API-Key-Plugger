{
 "$schema": "https://json.schemastore.org/claude-code-settings.json",
 "hooks": {
  "SessionStart": [
   {
    "matcher": "",
    "hooks": [
     {
      "type": "command",
      "command": "sh ./scripts/ecosystem-orient.sh"
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "node /home/user/remembrance-oracle-toolkit/src/tools/goggles-bash-hook.js || true",
      "statusMessage": "goggles: reading the inline command before it runs"
     }
    ]
   }
  ]
 }
}
